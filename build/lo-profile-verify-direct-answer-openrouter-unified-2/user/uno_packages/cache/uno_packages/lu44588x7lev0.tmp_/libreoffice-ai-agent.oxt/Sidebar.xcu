<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="LoaiaDeck" oor:op="replace">
        <prop oor:name="Id"><value>LoaiaDeck</value></prop>
        <prop oor:name="Title"><value xml:lang="en-US">AI Agent</value></prop>
        <prop oor:name="OrderIndex"><value>1000</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="LoaiaPanel" oor:op="replace">
        <prop oor:name="Id"><value>LoaiaPanel</value></prop>
        <prop oor:name="DeckId"><value>LoaiaDeck</value></prop>
        <prop oor:name="Title"><value xml:lang="en-US">Chat</value></prop>
        <prop oor:name="ImplementationURL"><value>private:resource/toolpanel/LoaiaPanelFactory/LoaiaPanel</value></prop>
        <prop oor:name="OrderIndex"><value>1000</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
