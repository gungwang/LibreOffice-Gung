# LibreOffice AI Agent local defaults
#
# The PowerShell dev and verification scripts load `.env` from:
# 1. the workspace root
# 2. this subproject root
#
# Existing process environment variables win over both files.

LOAIA_DEFAULT_PROVIDER=openrouter
LOAIA_DEFAULT_MODEL=openai/gpt-4.1-mini

# Set one of these in your ignored `.env` file before running a real OpenRouter check.
OPENROUTER_API_KEY=
# LOAIA_OPENROUTER_API_KEY=