<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog"
    xmlns:script="http://openoffice.org/2000/script"
    dlg:id="LoaiaSidebarShell"
    dlg:left="0"
    dlg:top="0"
    dlg:width="176"
    dlg:height="336"
    dlg:closeable="false"
    dlg:moveable="false"
    dlg:withtitlebar="false">
  <dlg:bulletinboard>
    <dlg:text dlg:id="Title"
        dlg:tab-index="0"
        dlg:left="6"
        dlg:top="4"
        dlg:width="160"
        dlg:height="10"
        dlg:value="AI Agent"/>
    <dlg:textfield dlg:id="ChatOutput"
        dlg:tab-index="1"
        dlg:left="6"
        dlg:top="16"
        dlg:width="160"
        dlg:height="160"
        dlg:vscroll="true"
        dlg:multiline="true"
        dlg:readonly="true"
        dlg:value="Ready. Type a message below to chat with AI."/>
    <dlg:textfield dlg:id="PromptInput"
        dlg:tab-index="2"
        dlg:left="6"
        dlg:top="180"
        dlg:width="126"
        dlg:height="28"
        dlg:multiline="true"
        dlg:value=""/>
    <dlg:button dlg:id="SendButton"
        dlg:tab-index="3"
        dlg:left="136"
        dlg:top="180"
        dlg:width="30"
        dlg:height="28"
        dlg:value="Send">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:Send" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:id="SettingsLabel"
        dlg:tab-index="4"
        dlg:left="6"
        dlg:top="214"
        dlg:width="160"
        dlg:height="10"
        dlg:value="--- Settings ---"/>
    <dlg:text dlg:id="ApiKeyLabel"
        dlg:tab-index="5"
        dlg:left="6"
        dlg:top="228"
        dlg:width="36"
        dlg:height="10"
        dlg:value="API Key:"/>
    <dlg:textfield dlg:id="ApiKeyInput"
        dlg:tab-index="6"
        dlg:left="44"
        dlg:top="226"
        dlg:width="122"
        dlg:height="12"
        dlg:value=""
        dlg:echochar="42"/>
    <dlg:text dlg:id="ModelLabel"
        dlg:tab-index="7"
        dlg:left="6"
        dlg:top="244"
        dlg:width="36"
        dlg:height="10"
        dlg:value="Model:"/>
    <dlg:textfield dlg:id="ModelInput"
        dlg:tab-index="8"
        dlg:left="44"
        dlg:top="242"
        dlg:width="122"
        dlg:height="12"
        dlg:value=""/>
    <dlg:text dlg:id="ProviderLabel"
        dlg:tab-index="9"
        dlg:left="6"
        dlg:top="260"
        dlg:width="36"
        dlg:height="10"
        dlg:value="Provider:"/>
    <dlg:textfield dlg:id="ProviderInput"
        dlg:tab-index="10"
        dlg:left="44"
        dlg:top="258"
        dlg:width="122"
        dlg:height="12"
        dlg:value="openrouter"/>
    <dlg:button dlg:id="SaveSettingsButton"
        dlg:tab-index="11"
        dlg:left="6"
        dlg:top="276"
        dlg:width="160"
        dlg:height="14"
        dlg:value="Save Settings">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:SaveSettings" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:id="SettingsStatus"
        dlg:tab-index="12"
        dlg:left="6"
        dlg:top="294"
        dlg:width="160"
        dlg:height="36"
        dlg:value="Set your API key, model, and provider above."
        dlg:multiline="true"/>
  </dlg:bulletinboard>
</dlg:window>