<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="LoaiaPanelRoot">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <child>
      <object class="GtkLabel" id="LoaiaTitle">
        <property name="label">LibreOffice AI Agent</property>
        <property name="xalign">0</property>
      </object>
    </child>
    <child>
      <object class="GtkTextView" id="LoaiaConversationView"/>
    </child>
  </object>
</interface>
